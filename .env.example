# Session cookie encryption key, used by iron-session (lib/session.ts).
# Must be a random string at least 32 characters long.
# Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=replace-this-with-a-random-32+-character-string

# Vellar x402 facilitator to talk to. Defaults to the hosted testnet
# instance if unset — see lib/config.ts.
FACILITATOR_URL=https://vellar-facilitator.onrender.com

# Demo seller service the playground pays against. Defaults to the hosted
# testnet instance if unset — see lib/config.ts.
SELLER_URL=https://vellar-seller-demo.onrender.com
